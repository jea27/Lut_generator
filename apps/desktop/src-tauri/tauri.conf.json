{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Color Studio Beta",
  "version": "0.3.0-beta.4",
  "identifier": "local.colorstudio.beta",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Offline colour grading technical beta",
    "resources": {
      "binaries/runtime/": "runtime/",
      "../../../packaging/notices/": "notices/",
      "binaries/installer-manifest.json": "installer-manifest.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": true,
        "template": "../../../packaging/nsis/installer.nsi",
        "installerHooks": "binaries/installer-vars.nsh",
        "allowDowngrades": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "useLocalToolsDir": true
  }
}
