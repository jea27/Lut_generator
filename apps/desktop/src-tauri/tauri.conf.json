{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Color Studio Beta",
  "version": "0.2.0-beta.1",
  "identifier": "local.colorstudio.beta",
  "build": {"frontendDist": "../../web/dist"},
  "app": {"windows": [], "security": {"capabilities": []}},
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Offline colour grading technical beta",
    "externalBin": ["binaries/ColorEngine"],
    "resources": {"binaries/_internal/": "_internal/", "../../../packaging/notices/": "notices/"},
    "windows": {
      "nsis": {"installMode": "currentUser", "languages": ["Spanish", "English"], "displayLanguageSelector": true},
      "webviewInstallMode": {"type": "offlineInstaller", "silent": true}
    }
  }
}
